{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },

  "files": {
    "includes": ["**", "!**/.astro", "!**/dist", "!**/node_modules"]
  },

  "formatter": {
    "enabled": false
  },

  "linter": {
    "rules": {
      "recommended": true
    }
  },

  "overrides": [
    {
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      },

      "includes": ["**/*.astro"],

      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          },

          "style": {
            "useConst": "off",
            "useImportType": "off"
          }
        }
      }
    }
  ]
}
