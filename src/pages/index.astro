---
import ArrowCard from "@components/ArrowCard.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE, SOCIALS } from "@config/consts";
import HomeLayout from "@layouts/HomeLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

type BlogPost = CollectionEntry<"blog">;

const blog = ((await getCollection("blog")) as BlogPost[])
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<HomeLayout description={SITE.DESCRIPTION} canonical={`${Astro.site}`}>
  <Container>
    <div class="space-y-11">
      <section>
        <article class="space-y-3">
          <h1 class="font-onest text-4xl font-bold tracking-tight text-[#1a1916]">
            {SITE.TITLE}
          </h1>
          <p class="text-md m-0 p-0 leading-relaxed">
            A lifelong learner with a passion for keeping up with the latest trends and developments in the ever-evolving field of
            software engineering.
          </p>
        </article>
      </section>

      <section class="space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-y-2 text-sm text-black">
          <h5 class="font-semibold">Blog</h5>
          <Link href="/blog">See all posts</Link>
        </div>
        <ul class="flex flex-col gap-2">
          {
            blog.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-y-2 text-sm text-black">
          <h5 class="font-semibold">Projects</h5>
          <Link href="/projects">See all projects</Link>
        </div>
        <ul class="flex flex-col gap-2">
          {
            projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="space-y-2">
        <ul class="flex flex-wrap gap-2 text-sm text-black">
          {
            SOCIALS.map((SOCIAL) => (
              <li class="flex gap-x-2 text-nowrap">
                <Link
                  href={SOCIAL.HREF}
                  external
                  aria-label={`
										${SITE.TITLE} on ${SOCIAL.NAME}
									`}
                >
                  {SOCIAL.NAME}
                </Link>
                {"•"}
              </li>
            ))
          }
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={"Email Roki Miftah Kamaludin"}>
              {"Email"}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</HomeLayout>
