---
import BackToPrev from "@components/BackToPrev.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import Link from "@components/Link.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { readingTime } from "@utils";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
	const projects = (await getCollection("projects"))
		.filter((project: CollectionEntry<"projects">) => !project.data.draft)
		.sort(
			(a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) =>
				b.data.date.valueOf() - a.data.date.valueOf()
		);

	return projects.map((project: CollectionEntry<"projects">) => ({
		params: { slug: project.id },
		props: project,
	}));
}

type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { Content, headings } = await render(project);
---

<PageLayout title={project.data.title} heading={headings}>
	<Container>
		<div>
			<BackToPrev href="/projects"> Projects </BackToPrev>
		</div>
		<div class="my-10 space-y-1">
			<div class="flex items-center gap-1.5">
				<div class="font-base text-sm">
					<FormattedDate date={project.data.date} />
				</div>
				&bull;
				<div class="font-base text-sm">
					{readingTime(project.body!)}
				</div>
			</div>
			<div
				id={project.data.title
					.toLowerCase()
					.replace(/[^a-z0-9]+/g, "-")
					.replace(/^-*|-*$/g, "")}
				class="scroll-mt-8 text-2xl font-semibold text-black"
			>
				{project.data.title}
			</div>
			{
				(project.data.demoURL || project.data.repoURL) && (
					<nav class="flex gap-1">
						{project.data.demoURL && (
							<Link href={project.data.demoURL} external>
								Demo
							</Link>
						)}
						{project.data.demoURL && project.data.repoURL && (
							<span>&nbsp; / &nbsp;</span>
						)}
						{project.data.repoURL && (
							<Link href={project.data.repoURL} external>
								Repository
							</Link>
						)}
					</nav>
				)
			}
		</div>
		<article>
			<Content />
		</article>
	</Container>
</PageLayout>
