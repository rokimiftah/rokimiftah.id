---
import type { MarkdownHeading } from "astro";

type Props = {
  headings: MarkdownHeading[];
  title: string;
};

const { headings, title } = Astro.props;

const titleSlug = title
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-*|-*$/g, "");
---

<nav id="table-of-contents" class="fixed top-[50%] left-4 hidden w-80 -translate-y-1/2 2xl:block">
  <div class="rounded-xl border border-gray-300/70 bg-linear-to-br from-gray-50 to-white p-5 shadow-sm backdrop-blur-sm">
    <h2 class="mb-4 text-sm font-bold tracking-wider text-gray-700 uppercase">
      <a href={`#${titleSlug}`} class="flex items-center gap-2 transition-colors duration-200 hover:text-gray-950">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="8" y1="6" x2="21" y2="6"></line>
          <line x1="8" y1="12" x2="21" y2="12"></line>
          <line x1="8" y1="18" x2="21" y2="18"></line>
          <line x1="3" y1="6" x2="3.01" y2="6"></line>
          <line x1="3" y1="12" x2="3.01" y2="12"></line>
          <line x1="3" y1="18" x2="3.01" y2="18"></line>
        </svg>
        Table of Contents
      </a>
    </h2>
    <div id="toc-scroll-container" class="max-h-[calc(80vh-8rem)] overflow-y-auto pr-2">
      <ul class="relative space-y-0.5 text-sm">
        {
          headings.map((heading) => (
            <li class="relative" style={{ paddingLeft: `${(heading.depth - 2) * 12}px` }}>
              <a
                href={`#${heading.slug}`}
                class="toc-link group relative flex items-center gap-2 rounded-lg px-3 py-2 text-gray-600 transition-all duration-200 hover:bg-gray-100 hover:text-gray-950"
                data-slug={heading.slug}
              >
                <span class="block leading-snug">{heading.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<script>
  function initTableOfContents() {
    const tocNav = document.getElementById("table-of-contents");
    if (!tocNav) return;

    const tocLinks = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
    const tocScrollContainer = document.getElementById("toc-scroll-container");

    if (tocLinks.length === 0) return;

    // Collect all heading elements
    const headings: Array<{ element: HTMLElement; slug: string }> = [];
    tocLinks.forEach((link) => {
      const slug = link.getAttribute("data-slug");
      if (slug) {
        const element = document.getElementById(slug);
        if (element) {
          headings.push({ element, slug });
        }
      }
    });

    if (headings.length === 0) return;

    let isScrolling = false;
    let currentActiveSlug: string | null = null;

    function setActiveLink(slug: string | null) {
      if (currentActiveSlug === slug) return;
      currentActiveSlug = slug;

      tocLinks.forEach((link) => {
        const linkSlug = link.getAttribute("data-slug");
        const isActive = linkSlug === slug;

        if (isActive) {
          link.classList.add("!bg-gray-950/10");

          // Auto scroll TOC to show active item
          if (tocScrollContainer && !isScrolling) {
            const linkRect = link.getBoundingClientRect();
            const containerRect = tocScrollContainer.getBoundingClientRect();

            if (linkRect.top < containerRect.top || linkRect.bottom > containerRect.bottom) {
              link.scrollIntoView({ behavior: "smooth", block: "center" });
            }
          }
        } else {
          link.classList.remove("!bg-gray-950/10");
        }
      });
    }

    function findActiveHeading() {
      // Find the heading closest to the top of the viewport
      let activeSlug: string | null = null;
      const scrollPosition = window.scrollY + 100; // Offset for better UX

      for (let i = headings.length - 1; i >= 0; i--) {
        const heading = headings[i];
        const headingTop = heading.element.offsetTop;

        if (scrollPosition >= headingTop) {
          activeSlug = heading.slug;
          break;
        }
      }

      setActiveLink(activeSlug);
    }

    // Handle scroll events
    let scrollTimeout: ReturnType<typeof setTimeout>;
    function onScroll() {
      if (scrollTimeout) clearTimeout(scrollTimeout);

      scrollTimeout = setTimeout(() => {
        isScrolling = false;
      }, 100);

      findActiveHeading();
    }

    // Handle clicks on TOC links
    tocLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        isScrolling = true;

        const slug = link.getAttribute("data-slug");
        if (slug) {
          const target = document.getElementById(slug);
          if (target) {
            setActiveLink(slug);
            target.scrollIntoView({ behavior: "smooth" });

            // Update URL without jumping
            history.pushState(null, "", `#${slug}`);

            setTimeout(() => {
              isScrolling = false;
            }, 1000);
          }
        }
      });
    });

    // Listen to scroll events
    window.addEventListener("scroll", onScroll, { passive: true });

    // Initial check
    findActiveHeading();
  }

  // Initialize on page load
  document.addEventListener("astro:page-load", initTableOfContents);

  // Also initialize immediately if DOM is already loaded
  if (document.readyState !== "loading") {
    initTableOfContents();
  }
</script>
