---
import Head from "@components/Head.astro";

type Props = {
	title?: string;
	description: string;
	canonicalURL: string;
};

const { title, description, canonicalURL } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<Head
			title={title}
			description={description}
			canonicalURL={canonicalURL}
		/>
	</head>
	<body>
		<main>
			<slot />
		</main>
	</body>
</html>
