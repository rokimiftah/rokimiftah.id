---
import Head from "@components/Head.astro";

type Props = {
	title?: string;
	description: string;
	canonical: string;
};

const { title, description, canonical } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<Head title={title} description={description} canonical={canonical} />
	</head>
	<body>
		<main>
			<slot />
		</main>
	</body>
</html>
